rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only Tintin's account (ahaan@tintinopedia.com) can write.
    // Google sign-in verifies the email; GitHub sign-in counts once it is linked to that Google account.
    function isAhaan() {
      return request.auth != null
        && request.auth.token.email == 'ahaan@tintinopedia.com'
        && (request.auth.token.email_verified == true
            || 'google.com' in request.auth.token.firebase.identities);
    }

    function prevComplete(day) {
      return day == 1
        || get(/databases/$(database)/documents/sessions/$(string(day - 1))).data.status == 'complete';
    }

    // Season 1 has 164 built-in days; later days must be planned in customDays first.
    function dayExists(day) {
      return day <= 164 || exists(/databases/$(database)/documents/customDays/$(string(day)));
    }

    // Logged sessions: public read, written in order.
    match /sessions/{dayId} {
      allow read: if true;
      allow create: if isAhaan()
        && request.resource.data.day == int(dayId)
        && int(dayId) >= 1
        && dayExists(int(dayId))
        && request.resource.data.status in ['draft', 'complete']
        && prevComplete(int(dayId));
      allow update: if isAhaan()
        && request.resource.data.day == resource.data.day
        && request.resource.data.status in ['draft', 'complete']
        && (resource.data.status != 'complete' || request.resource.data.status == 'complete')
        && prevComplete(int(dayId));
      allow delete: if false;
    }

    // Sessions planned in Studio after Day 164.
    match /customDays/{dayId} {
      allow read: if true;
      allow create, update: if isAhaan()
        && int(dayId) > 164
        && request.resource.data.day == int(dayId)
        && (int(dayId) == 165 || exists(/databases/$(database)/documents/customDays/$(string(int(dayId) - 1))));
      allow delete: if isAhaan()
        && !exists(/databases/$(database)/documents/sessions/$(dayId));
    }

    // Drill library (custom codes and edits to built-in ones).
    match /codes/{code} {
      allow read: if true;
      allow write: if isAhaan();
    }

    // Reference images uploaded in the drill library.
    match /images/{id} {
      allow read: if true;
      allow create: if isAhaan() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow delete: if isAhaan();
      allow update: if false;
    }

    // My Videos: the public sees published videos only.
    match /videos/{id} {
      allow read: if resource.data.published == true || isAhaan();
      allow write: if isAhaan();
    }

    // Mantra text and voice recordings are private to Tintin's account.
    match /mantra/{id} {
      allow read, write: if isAhaan();
    }
    match /recordings/{id} {
      allow read, delete: if isAhaan();
      allow create: if isAhaan() && request.resource.data.data is string && request.resource.data.data.size() < 1000000;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
